# Copy to .env for local/staging use. Keep real credentials out of Git.
SHELFMARK_DB_PATH=/data/shelfmark.db
SHELFMARK_AUDIOBOOKS_ROOT=/audiobooks
SHELFMARK_EBOOKS_ROOT=/ebooks
SHELFMARK_INCOMING_ROOT=/incoming
SHELFMARK_WORK_ROOT=/work
SHELFMARK_QUARANTINE_ROOT=/quarantine

# Required before exposing the API outside a private developer network.
SHELFMARK_API_TOKEN=replace-with-a-long-random-token
SHELFMARK_API_URL=http://shelfmark-api:8000
SHELFMARK_WORKER_POLL_SECONDS=2
SHELFMARK_LOG_LEVEL=INFO
SHELFMARK_HTTP_TIMEOUT_SECONDS=15
SHELFMARK_HTTP_RETRIES=3
# Trip the breaker after this many consecutive provider-health failures
# (connection errors, timeouts, 5xx -- not 401/404), then fail fast for the
# cooldown before allowing one trial request through again.
SHELFMARK_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SHELFMARK_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
SHELFMARK_TRANSFER_SETTLE_SECONDS=30
SHELFMARK_TRANSFER_POLL_SECONDS=5
SHELFMARK_TRANSFER_TIMEOUT_SECONDS=3600
SHELFMARK_WORKER_STALE_SECONDS=900

# Existing service APIs (keep these on the private network).
AUDIOBOOKSHELF_URL=http://audiobookshelf:80
AUDIOBOOKSHELF_API_TOKEN=replace-with-abs-token
AUDIOBOOKSHELF_LIBRARY_ID=replace-with-library-id
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=replace-with-prowlarr-key
# Categories /ebook-request restricts to when the indexer doesn't advertise
# 7020 (EBook) specifically. Default 7000 (Books) matches a typical indexer.
PROWLARR_BOOK_CATEGORIES=7000
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=replace-with-qbittorrent-user
QBITTORRENT_PASSWORD=replace-with-qbittorrent-password
# For qBittorrent >= 5.2, an API key can be used instead of username/password.
QBITTORRENT_API_KEY=
# Category the reconciler watches for finished downloads. Matches
# /api/v1/downloads' own default.
QBITTORRENT_CATEGORY=shelfmark-books
# grab_release adds a release to qBittorrent DIRECTLY (not through Prowlarr's
# own /api/v1/search grab, which routes to whatever download client Prowlarr
# itself has configured -- a different category the reconciler never
# watches). A private-tracker downloadUrl looks like
# http://<prowlarr-host>:9696/1/download?apikey=...&link=... -- Prowlarr
# proxies the real .torrent using its own credentials, but the host in that
# URL is PROWLARR's own view of itself, which may not be reachable from
# qBittorrent's network namespace. This is the base (scheme+host only) that
# gets substituted in before handing the URL to qBittorrent; the path and
# full query string are left untouched. Default matches the container-name
# convention PROWLARR_URL already uses on the shared download network.
QBITTORRENT_PROWLARR_BASE_URL=http://prowlarr:9696

# Automatic grab -> transfer -> organize -> scan pipeline (see README's
# "Automatic download pipeline" section). ON by default; flip to false and
# restart to stop automation without a different deploy.
SHELFMARK_DOWNLOAD_AUTOMATION_ENABLED=true
SHELFMARK_RECONCILE_INTERVAL_SECONDS=60
# Discord webhook URL (Server Settings -> Integrations -> Webhooks) for
# pipeline completion/failure notifications. Optional -- unset means no
# notifications, not an error.
SHELFMARK_DISCORD_WEBHOOK_URL=

# Restricted Sullivan SSH/rsync pull account.
SULLIVAN_SSH_HOST=10.0.0.2
SULLIVAN_SSH_USER=shelfmark-sync
SULLIVAN_SSH_IDENTITY_FILE=/run/secrets/shelfmark_sullivan_ed25519
SULLIVAN_SSH_PORT=22
SULLIVAN_COMPLETED_ROOT=/complete/shelfmark-books

# Discord bot (invite with bot + applications.commands scopes).
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
SHELFMARK_DISCORD_GUILD_ID=replace-with-development-guild-id
SHELFMARK_DISCORD_ALLOWED_ROLE_IDS=
# Discord's own attachment cap is 10 MB on an unboosted server; raise this if
# the server is boosted.
SHELFMARK_DISCORD_MAX_ATTACHMENT_MB=10
