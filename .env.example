# Copy to .env for local/staging use. Keep real credentials out of Git.
SHELFMARK_DB_PATH=/data/shelfmark.db
SHELFMARK_AUDIOBOOKS_ROOT=/audiobooks
SHELFMARK_EBOOKS_ROOT=/ebooks
SHELFMARK_INCOMING_ROOT=/incoming
SHELFMARK_WORK_ROOT=/work
SHELFMARK_QUARANTINE_ROOT=/quarantine

# Required before exposing the API outside a private developer network.
SHELFMARK_API_TOKEN=replace-with-a-long-random-token
SHELFMARK_WORKER_POLL_SECONDS=2
SHELFMARK_LOG_LEVEL=INFO
